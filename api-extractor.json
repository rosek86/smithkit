{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/lib/index.d.ts",
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": false,
        "types": [],
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
      },
      "files": ["dist/lib/index.d.ts"]
    }
  },
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/docs/api",
    "reportTempFolder": "<projectFolder>/dist/api-report",
    "includeForgottenExports": true
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-forgotten-export": {
        "logLevel": "error",
        "addToApiReportFile": false
      }
    }
  },
  "newlineKind": "lf"
}
