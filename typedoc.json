{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Smithkit",
  "entryPoints": ["dist/lib/index.d.ts"],
  "tsconfig": "tsconfig.docs.json",
  "out": "public/api",
  "readme": "docs/guide/index.md",
  "projectDocuments": [
    "docs/guide/getting-started.md",
    "docs/guide/configuration.md",
    "docs/guide/traces.md",
    "docs/guide/events.md",
    "docs/guide/scales.md",
    "docs/guide/rf.md",
    "docs/guide/touchstone.md",
    "docs/guide/export.md",
    "docs/guide/frameworks.md"
  ],
  "alwaysCreateEntryPointModule": false,
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableSources": true,
  "searchInDocuments": true,
  "searchInComments": true,
  "customCss": "docs/api.css",
  "treatWarningsAsErrors": true,
  "navigationLinks": {
    "Demo": "https://rosek86.github.io/smithkit/",
    "Examples": "https://rosek86.github.io/smithkit/examples/index.html",
    "GitHub": "https://github.com/rosek86/smithkit"
  },
  "visibilityFilters": {}
}
